# rpn-frontend/.env on the VPS — read by docker-compose.yml as build args (baked into the bundle).
# Rebuild (docker compose up -d --build) after changing anything here. Never commit .env.

NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Public backend URL (nginx → rpn-backend). The old https://api-rpn.ruangin.xyz still works during the move.
NEXT_PUBLIC_API_URL=https://api.rajapisangnugget.com
# Google Maps / Places / Geocoding / Static Maps key (referrer-restricted to the frontend domain).
# Empty = Leaflet map without address search.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_BRAND_NAME=Raja Pisang Nugget

# Host port (127.0.0.1 only) that nginx proxies to.
# FRONTEND_PORT=3000
